CREATE TABLE FavoriteRepositoryId (
    id INTEGER NOT NULL PRIMARY KEY
);

selectAll:
SELECT id
FROM FavoriteRepositoryId;

selectById:
SELECT id
FROM FavoriteRepositoryId
WHERE id = ?;

insertOrReplace:
INSERT OR REPLACE INTO FavoriteRepositoryId (id)
VALUES (?);

deleteById:
DELETE FROM FavoriteRepositoryId
WHERE id = ?;
